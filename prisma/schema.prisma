// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TripStatus {
  IN_PROGRESS
  GENERATED
}

model User {
  id        String      @id @default(cuid())
  auth0Id   String      @unique
  email     String?     @unique
  name      String?
  imageUrl  String?
  trips     Trip[]
  ownedItems OwnedItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model Trip {
  id              String       @id @default(cuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String?
  destination     String
  tripLengthDays  Int
  partySize       Int
  weatherSummary  String?
  status          TripStatus   @default(IN_PROGRESS)
  intake          TripIntake?
  packingList     PackingList?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([userId])
}

model TripIntake {
  id               String   @id @default(cuid())
  tripId           String   @unique
  trip             Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  answersJson      Json
  clarificationsJson Json?
  rawInputJson     Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model PackingList {
  id               String            @id @default(cuid())
  tripId           String            @unique
  trip             Trip              @relation(fields: [tripId], references: [id], onDelete: Cascade)
  provider         String
  model            String
  promptVersion    String
  generationMetadata Json?
  rawOutputJson    Json
  categories       PackingCategory[]
  createdAt        DateTime          @default(now())
}

model PackingCategory {
  id              String         @id @default(cuid())
  packingListId   String
  packingList     PackingList    @relation(fields: [packingListId], references: [id], onDelete: Cascade)
  name            String
  sortOrder       Int
  items           PackingItem[]

  @@index([packingListId, sortOrder])
}

model PackingItem {
  id                String           @id @default(cuid())
  packingCategoryId  String
  packingCategory    PackingCategory  @relation(fields: [packingCategoryId], references: [id], onDelete: Cascade)
  name              String
  quantity          String?
  notes             String?
  sortOrder         Int
  isRequired        Boolean          @default(true)

  @@index([packingCategoryId, sortOrder])
}

model OwnedItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  category  String?
  quantity  String?
  notes     String?
  isArchived Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isArchived])
}
